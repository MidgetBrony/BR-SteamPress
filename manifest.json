{
  "schemaVersion": 1,
  "id": "br-steam-press",
  "name": "BR-SteamPress",
  "author": "Rusty",
  "description": "Publishes recent Steam news as dated, readable magazines in BOXROOM through BR-BookSystem.",
  "repository": "https://github.com/MidgetBrony/BR-SteamPress",
  "requirements": {
    "melonLoader": "0.7.0"
  },
  "dependencies": [
    {
      "manifest": "https://raw.githubusercontent.com/MidgetBrony/BR-MediaAPI/refs/heads/main/manifest.json",
      "minimumVersion": "1.1.2",
      "required": true
    },
    {
      "manifest": "https://raw.githubusercontent.com/MidgetBrony/ModsPanel/refs/heads/master/manifest.json",
      "minimumVersion": "2.6.2",
      "required": true
    },
    {
      "manifest": "https://raw.githubusercontent.com/MidgetBrony/BR-BookSystem/refs/heads/main/manifest.json",
      "minimumVersion": "2.1.0",
      "required": true
    }
  ],
  "release": {
    "provider": "github",
    "asset": "BR-SteamPress-*.zip",
    "checksumAsset": "SHA256SUMS.txt",
    "destination": "Mods"
  }
}
