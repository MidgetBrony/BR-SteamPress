<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>BR_SteamPress</AssemblyName>
    <RootNamespace>BR_SteamPress</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyVersion>0.3.3.0</AssemblyVersion>
    <FileVersion>0.3.3.0</FileVersion>
    <GamePath Condition="'$(GamePath)' == ''">$(BOXROOM_GAME_PATH)</GamePath>
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
  </PropertyGroup>

  <Target Name="ValidateGamePath" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(GamePath)' == '' Or !Exists('$(GamePath)\BOXROOM_Data\Managed\Assembly-CSharp.dll')">
    <Error Text="Set GamePath in Directory.Build.user.props or pass -p:GamePath=..." />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GamePath)\BOXROOM_Data\Managed\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MelonLoader"><HintPath>$(GamePath)\MelonLoader\net35\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GamePath)\BOXROOM_Data\Managed\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SkiaSharp"><HintPath>$(GamePath)\BOXROOM_Data\Managed\SkiaSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ModsPanel"><HintPath>$(GamePath)\Mods\ModsPanel.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BR_MediaAPI"><HintPath>$(GamePath)\Mods\BR_MediaAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BR_BookSystem"><HintPath>$(GamePath)\Mods\BR_BookSystem.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\*.png" />
    <EmbeddedResource Include="Assets\*.ttf" />
  </ItemGroup>

  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(GamePath)\Mods" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\Mods" SkipUnchangedFiles="true" />
  </Target>
</Project>
